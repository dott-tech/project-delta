DATABASE_URL="postgresql://postgres:password@localhost:5432/structural_hub?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/structural_hub?schema=public"
# Use a unique random secret in production; never deploy this placeholder.
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
# In production, set this to the exact https:// URL of the frontend (comma-separate multiple origins).
CORS_ORIGIN="http://localhost:5173"
# Configure only when running behind a trusted reverse proxy/load balancer (e.g. "1").
# TRUST_PROXY="1"

# Required for the primary project file upload flow
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="your-private-bucket"
# Keep S3 Block Public Access enabled; grant the backend only the bucket/object permissions it needs.
# Optional when the AWS SDK default credential provider chain is configured:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
